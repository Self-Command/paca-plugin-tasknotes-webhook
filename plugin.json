{
  "id": "com.selfcommand.tasknotes-webhook",
  "displayName": "TaskNotes 接入",
  "description": "双向同步官方 TaskNotes 和 Paca 任务，管理来源、冲突及循环排期。",
  "version": "0.1.0",
  "minCoreVersion": "v0.18.6",
  "permissions": [
    "db.read",
    "db.write",
    "events.subscribe"
  ],
  "customPermissions": [
    {
      "key": "tasknotes_webhook.read",
      "label": "查看 TaskNotes 接入与同步记录",
      "scope": "project"
    },
    {
      "key": "tasknotes_webhook.manage",
      "label": "管理 TaskNotes 来源与状态映射",
      "scope": "project"
    },
    {
      "key": "tasknotes_webhook.worker_manage",
      "label": "管理 TaskNotes 服务连接",
      "scope": "global"
    }
  ],
  "backend": {
    "allowedConfigKeys": [
      "ENCRYPTION_KEY",
      "PUBLIC_URL"
    ],
    "eventSubscriptions": [
      "task.created",
      "task.updated",
      "task.deleted"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/status",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/admin/worker-credential",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": [
              "tasknotes_webhook.worker_manage"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/worker/control",
        "public": true
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/connections",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/connections",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.manage"
            ]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/connections/:id",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.manage"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/connections/:id/rotate-secret",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.manage"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/connections/:id/deliveries",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/connections/:id/sources",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/connections/:id/reprocess/:deliveryId",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.manage"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/connections/:id/link",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.manage"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/receive/:id",
        "public": true
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/source-link",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "PUT",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.manage"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/connections/:id/sync-config"
      },
      {
        "method": "GET",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.read"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/connections/:id/sync-preview"
      },
      {
        "method": "POST",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.manage"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/connections/:id/pairing"
      },
      {
        "method": "DELETE",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.manage"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/connections/:id/pairing/:credential"
      },
      {
        "method": "GET",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.read"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/tasks/:taskId/recurrence"
      },
      {
        "method": "PUT",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.manage"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/tasks/:taskId/recurrence"
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/source-status",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/connections/:id/note-bindings",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "tasknotes_webhook.read"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.read"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/connections/:id/history-cleanup"
      },
      {
        "method": "POST",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "permissions": [
              "tasknotes_webhook.manage"
            ],
            "scope": "project"
          }
        ],
        "path": "/projects/:projectId/connections/:id/history-cleanup"
      }
    ],
    "sensitiveFields": {
      "worker_settings": [
        "secret_enc"
      ],
      "connections": [
        "secret_enc"
      ]
    }
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.selfcommand.tasknotes-webhook/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.settings.tab",
        "component": "SettingsTab",
        "label": "TaskNotes 接入",
        "order": 120,
        "requiredPermission": "tasknotes_webhook.read"
      },
      {
        "point": "task.detail.section",
        "component": "TaskSourceSection",
        "label": "TaskNotes 来源",
        "order": 110,
        "requiredPermission": "tasknotes_webhook.read"
      },
      {
        "point": "task.detail.section",
        "component": "TaskRecurrenceSection",
        "label": "重复计划",
        "order": 111,
        "requiredPermission": "tasknotes_webhook.read"
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.selfcommand.tasknotes-webhook/mcp.js"
  }
}
